# Sao chép file này thành backend/.env rồi điền giá trị thật.
# KHÔNG BAO GIỜ commit file .env thật lên Git (đã có trong .gitignore).

PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=asset_management

# Tạo bằng lệnh: openssl rand -hex 32 (hoặc: python3 -c "import secrets; print(secrets.token_hex(32))")
# Không dùng lại bất kỳ giá trị mẫu/hardcode nào trong source code.
JWT_SECRET=

# URL của frontend, dùng để tạo CORS whitelist và link trong QR code
FRONTEND_URL=http://localhost:5173
